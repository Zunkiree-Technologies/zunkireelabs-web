<style>
  .showcase-track-container {
    --card-width: 72%;
    --card-gap: 1rem;
    --card-offset: 14%;
  }
  @media (min-width: 1024px) {
    .showcase-track-container {
      --card-width: 48%;
      --card-gap: 1.5rem;
      --card-offset: 26%;
    }
  }
  @media (min-width: 1088px) {
    .showcase-title-area {
      margin-left: calc((100% - 1024px) / 2 - 2rem);
    }
  }
</style>

<section
  class="relative flex flex-col justify-center overflow-hidden bg-sky-50 py-[20px]"
  x-data="{ activeTab: 1 }"
  aria-labelledby="industry-showcase-heading"
>
  <!-- Header Wrapper (Centered, padded) -->
  <div class="mx-auto w-full max-w-content px-4 sm:px-6 lg:px-8">
    <!-- Section Header Top Row — Header left, Actions right -->
    <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="max-w-2xl showcase-title-area">
        <h2 id="industry-showcase-heading" class="mb-4 text-[28px] font-semibold leading-[1.2] tracking-tight text-navy-900 sm:text-[32px] lg:text-[36px]">
          Find the industry that looks like yours
        </h2>
        <p class="text-body-lg text-navy-500">
          Four verticals, one shared platform, already running in production.
        </p>
      </div>

      <!-- Actions/CTAs -->
      <div class="flex flex-row items-center gap-3">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          Request a demo
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-navy-300 px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          Let's talk
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>

  <!-- Centered Carousel Track with Duplicated Boundary Cards for Infinite Looping (Full Bleed, No Gaps) -->
  {% set carouselItems = [
    industries[3],
    industries[0],
    industries[1],
    industries[2],
    industries[3],
    industries[0]
  ] %}

  <div class="showcase-track-container relative w-full overflow-hidden" data-reveal>
    <div
      class="flex transition-transform duration-500 ease-out"
      :style="'transform: translateX(calc(var(--card-offset) - (' + activeTab + ' * (var(--card-width) + var(--card-gap))))); gap: var(--card-gap);'"
    >
      {% for item in carouselItems %}
        {% set originalIndex = loop.index0 %}
        {# Map index for click behavior: Card 0 wraps to activeTab=4 (Real Estate), Card 5 wraps to activeTab=1 (Education) #}
        {% set targetTab = 4 if originalIndex == 0 else (1 if originalIndex == 5 else originalIndex) %}

        <div
          role="tabpanel"
          id="industry-panel-{{ originalIndex }}"
          aria-labelledby="industry-tab-{{ targetTab }}"
          :aria-hidden="activeTab !== {{ targetTab }} ? 'true' : 'false'"
          class="relative h-[440px] flex-shrink-0 snap-start overflow-hidden rounded-2xl shadow-subtle sm:h-[480px] transition-all duration-500 opacity-100"
          :class="activeTab === {{ targetTab }} ? 'scale-100 z-10' : 'scale-95 z-0 cursor-pointer'"
          style="width: var(--card-width);"
          @click="activeTab = {{ targetTab }}"
          :tabindex="activeTab === {{ targetTab }} ? 0 : -1"
        >
          <!-- Card Background photo -->
          <img
            src="{{ item.image }}"
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            width="1200"
            height="800"
          />

          <!-- Sky Tint overlay for image styling -->
          <div class="pointer-events-none absolute inset-0 bg-sky-900/20 mix-blend-color" aria-hidden="true"></div>

          <!-- Legibility scrims — linear gradient darken top/bottom, transparent center -->
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/60" aria-hidden="true"></div>

          <!-- Headline overlaid top-left on the image -->
          <div class="absolute left-6 top-6 max-w-[70%] sm:left-8 sm:top-8 sm:max-w-md z-20 text-left">
            <h3 class="text-[20px] font-semibold leading-[1.3] text-white sm:text-[24px] drop-shadow-md">
              {{ item.headline }}
            </h3>
          </div>

          <!-- Category badge overlaid top-right on the image -->
          <div class="absolute right-5 top-5 z-20 sm:right-6 sm:top-6">
            <div class="inline-flex items-center gap-2 rounded-full bg-black/35 px-3.5 py-1.5 backdrop-blur-md border border-white/10">
              <svg class="h-4 w-4 text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ item.iconPath }}"></path>
              </svg>
              <span class="text-[11px] font-mono uppercase tracking-wider text-white">
                {{ item.label }}
              </span>
            </div>
          </div>

          <!-- Floating stat or proof box on the bottom-right corner with glass effect -->
          <div class="absolute right-5 bottom-5 max-w-[280px] sm:right-6 sm:bottom-6 z-20">
            {% if item.proofType == "stat" %}
              <div class="rounded-lg bg-black/45 p-4 border border-white/10 backdrop-blur-md shadow-lg">
                <span class="block font-mono text-3xl font-semibold leading-none text-white sm:text-4xl">{{ item.statValue }}</span>
                <span class="mt-2 block text-[12.5px] font-medium leading-relaxed text-white/80">{{ item.statLabel }}</span>
              </div>
            {% else %}
              <div class="rounded-lg bg-black/45 p-4 border border-white/10 backdrop-blur-md shadow-lg">
                <span class="mb-1.5 block text-[10px] font-mono uppercase tracking-wider text-white">Flagship Proof</span>
                <span class="block text-[12.5px] leading-relaxed text-white/90">{{ item.proofLine }}</span>
              </div>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Tabs Wrapper (Centered, padded) -->
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 mt-12">
    <!-- Center-aligned Bottom Tabs -->
    <div class="flex justify-center" data-reveal>
      <div
        role="tablist"
        aria-label="Industries"
        class="grid grid-cols-2 gap-4 sm:flex sm:flex-row sm:gap-6 border-t border-navy-200/20 pt-6 w-full max-w-xl justify-center"
      >
        {% for industry in industries %}
          {% set tabIndex = loop.index %}
          <button
            type="button"
            role="tab"
            id="industry-tab-{{ loop.index0 }}"
            :aria-selected="activeTab === {{ tabIndex }} ? 'true' : 'false'"
            aria-controls="industry-panel-{{ tabIndex }}"
            :tabindex="activeTab === {{ tabIndex }} ? 0 : -1"
            @click="activeTab = {{ tabIndex }}"
            class="group text-left focus:outline-none flex-1 max-w-[120px]"
          >
            <!-- Indicator Line -->
            <div
              class="h-[3px] w-full transition-all duration-300 rounded-full"
              :class="activeTab === {{ tabIndex }} ? 'bg-[#76B900]' : 'bg-navy-200/30 group-hover:bg-navy-300/50'"
            ></div>
            <!-- Tab Label -->
            <span
              class="mt-3 block font-mono text-[11px] uppercase tracking-wider text-center transition-colors duration-200"
              :class="activeTab === {{ tabIndex }} ? 'text-navy-900 font-semibold' : 'text-navy-400 group-hover:text-navy-600'"
            >
              {{ industry.label }}
            </span>
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# =====================================================
   PROOF — Website V2
   Kore.ai's homepage runs a "We've built our business by serving
   global enterprises" strip with a trusted-by logo row under each
   industry card. We don't have logo image assets for our confirmed
   clients yet, so this is the text-badge equivalent — same
   structural slot, same "trusted by" framing, no image fabrication.

   Client list is the CONTENT_SUMMARY.md §4/§63 confirmed-real list
   only (Admizz, CoreCloud365, Rapid Investment, CMS Group, Mach24
   Orbital, Khushbu Nirman Sewa, Prime Tiles, Khems Cleaning) — no
   fabricated names, consistent with the anti-fabrication guardrail
   that already governs the Industry Showcase section above.


{# =====================================================
   AI INSIGHTS — Website V2
   Direct copy of Kore.ai's "AI Insights" blog teaser: heading +
   "View all" button, one large featured post left, a short list
   of smaller posts right. Pulled from the real `collections.blog`
   posts already published under src/blog/ — no placeholder content.
   ===================================================== #}
{% set sortedPosts = collections.blog | reverse %}
<section class="px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-28" aria-labelledby="insights-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-12" data-reveal>
      <h2 id="insights-heading" class="text-[28px] font-semibold leading-[1.2] text-navy-900 sm:text-[30px] lg:text-[32px]">
        AI Insights
      </h2>
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 rounded-md border border-navy-200 px-5 py-2.5 text-[13px] font-medium uppercase tracking-wider text-navy-900 transition-colors hover:border-navy-400 hover:bg-navy-50"
      >
        View all
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
      </a>
    </div>

    {% if sortedPosts.length %}
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3" data-reveal>

        <!-- Featured post -->
        {% set featured = sortedPosts[0] %}
        <a href="{{ featured.url }}" class="group relative flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-2xl bg-navy-100 p-6 lg:col-span-2 sm:p-8">
          {% if featured.data.featuredImage %}
            <img src="{{ featured.data.featuredImage }}" alt="{{ featured.data.featuredImageAlt or '' }}" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" width="960" height="540" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/20 to-transparent" aria-hidden="true"></div>
          {% endif %}
          <div class="relative z-10">
            <span class="mb-3 inline-block font-mono text-[12px] uppercase tracking-wider text-white/70">
              {{ featured.data.date | date("MMMM D, YYYY") }}
            </span>
            <h3 class="max-w-xl text-[22px] font-medium leading-[1.3] text-white sm:text-[26px]">
              {{ featured.data.title }}
            </h3>
          </div>
        </a>

        <!-- Secondary posts -->
        <div class="flex flex-col gap-6">
          {% for post in sortedPosts.slice(1, 3) %}
            <a href="{{ post.url }}" class="group flex items-start gap-4 rounded-xl border border-navy-100 bg-white p-4 transition-colors hover:border-navy-300">
              {% if post.data.featuredImage %}
                <img src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt or '' }}" class="h-20 w-20 flex-shrink-0 rounded-lg object-cover" loading="lazy" width="80" height="80" />
              {% endif %}
              <div class="min-w-0">
                <h3 class="mb-1.5 text-[16px] font-medium leading-snug text-navy-900 transition-colors group-hover:text-navy-600">
                  {{ post.data.title }}
                </h3>
                <span class="font-mono text-[11px] uppercase tracking-wider text-navy-400">
                  {{ post.data.date | date("MMMM D, YYYY") }}{% if post.data.readTime %} &middot; {{ post.data.readTime }} min{% endif %}
                </span>
              </div>
            </a>
          {% endfor %}
        </div>

      </div>
    {% endif %}
  </div>
</section>

{% include "partials/footer-v2.njk" %}

<script>
  (function() {
    const debugDiv = document.createElement('div');
    debugDiv.style.position = 'fixed';
    debugDiv.style.bottom = '20px';
    debugDiv.style.left = '20px';
    debugDiv.style.background = 'rgba(0,0,0,0.85)';
    debugDiv.style.color = '#ff4444';
    debugDiv.style.padding = '15px';
    debugDiv.style.zIndex = '999999';
    debugDiv.style.fontFamily = 'monospace';
    debugDiv.style.fontSize = '12px';
    debugDiv.style.maxHeight = '250px';
    debugDiv.style.maxWidth = '80%';
    debugDiv.style.borderRadius = '8px';
    debugDiv.style.border = '1px solid #ff4444';
    debugDiv.style.overflowY = 'auto';
    debugDiv.style.boxShadow = '0 4px 20px rgba(0,0,0,0.5)';
    debugDiv.innerHTML = '<div style="color: #44ff44; font-weight: bold; margin-bottom: 5px;">Canvas Debug Logger:</div>';
    document.body.appendChild(debugDiv);

    window.addEventListener('error', function(e) {
      debugDiv.innerHTML += `<div style="margin-top: 5px;">Error: ${e.message} at ${e.filename}:${e.lineno}</div>`;
    });
    
    const origError = console.error;
    console.error = function(...args) {
      origError.apply(console, args);
      debugDiv.innerHTML += `<div style="margin-top: 5px; color: #ff8888;">Console Error: ${args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' ')}</div>`;
    };
    
    const origWarn = console.warn;
    console.warn = function(...args) {
      origWarn.apply(console, args);
      debugDiv.innerHTML += `<div style="margin-top: 5px; color: #ffcc44;">Console Warn: ${args.join(' ')}</div>`;
    };
  })();
</script>
