---
layout: base.njk
---


{# =====================================================
   PLATFORM INFRASTRUCTURE PRODUCT PAGE LAYOUT — shared by
   /products/search/, /products/ai-crm/, /products/orca/.
   One file, data-driven via src/_data/platformProducts.js.
   Do not fork per-product — differences are data, not markup
   (same discipline as layouts/industry.njk). Visual language
   matches homepage-v2.njk/industry.njk (same tokens, same
   component recipes). Section rhythm loosely inspired by the
   Kore.ai "AI for Service" reference page (challenge blocks →
   alternating feature sections → capability grid → proof →
   related-solutions grid → CTA), adapted to our own product
   and brand — not a copy of their content or visuals.

   Sections render conditionally when a product has no content
   for them (trust strip, testimonial, FAQ) — this is what lets
   Orca reuse the same template honestly without invented proof.
   ===================================================== #}

{% set product = null %}
{% for p in platformProducts %}
  {% if p.id == productId %}
    {% set product = p %}
  {% endif %}
{% endfor %}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   HERO ICON MACRO — small stroke-icon set for the floating
   corner badges below. Our own capability glyphs (search,
   database, chat, mail, users, chart, workflow) — not
   third-party tool logos, so no integration is implied that
   isn't real.
   ===================================================== #}
{# =====================================================
   PAIN POINT VISUAL MACRO — tiny animated sky-blue mockups, one
   per pain-point block (by position: 1 = lead, 2/3 = secondary).
   Pure CSS/SVG loops, no JS. Reused verbatim from industry.njk.
   ===================================================== #}
{% macro painPointVisual(index) %}
  {% if index == 1 %}
    <div class="pp-visual pp-visual--lead pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-5" aria-hidden="true">
      <span class="pp-chat-bubble">
        <span class="pp-chat-dot"></span>
        <span class="pp-chat-dot"></span>
        <span class="pp-chat-dot"></span>
      </span>
      <span class="pp-chat-ring"></span>
    </div>
  {% elif index == 2 %}
    <div class="pp-visual pp-visual--sm pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-4" aria-hidden="true">
      <span class="pp-node pp-node--a"></span>
      <svg class="pp-node-line" viewBox="0 0 60 8" preserveAspectRatio="none"><line x1="2" y1="4" x2="58" y2="4" stroke-width="2" stroke-dasharray="4 4"/></svg>
      <span class="pp-node pp-node--b"></span>
    </div>
  {% else %}
    <div class="pp-visual pp-visual--sm pp-visual--rows pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-4" aria-hidden="true">
      <span class="pp-row" style="animation-delay: 0s"></span>
      <span class="pp-row" style="animation-delay: 0.2s"></span>
      <span class="pp-row" style="animation-delay: 0.4s"></span>
    </div>
  {% endif %}
{% endmacro %}

{% macro heroBadgeIcon(name) %}
  {% if name == "search" %}
    <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
  {% elif name == "database" %}
    <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
  {% elif name == "chat" %}
    <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path>
  {% elif name == "mail" %}
    <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>
  {% elif name == "users" %}
    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
  {% elif name == "chart" %}
    <path d="M3 3v18h18"></path><rect x="7" y="12" width="3" height="6"></rect><rect x="12" y="8" width="3" height="10"></rect><rect x="17" y="4" width="3" height="14"></rect>
  {% elif name == "workflow" %}
    <polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line>
  {% endif %}
{% endmacro %}

{# =====================================================
   USE CASE ICON MACRO — small rotating glyph set for the
   Use Cases tab panel (feature-row chips + visual-panel badge).
   Generic capability marks, not per-feature icons (the data
   only carries feature labels, no icon field) — cycles by
   index so every product's useCases items get a consistent,
   deliberate mark rather than a repeated placeholder.
   ===================================================== #}
{% macro useCaseIcon(index, sizeClass="h-4 w-4") %}
  {% set glyph = index % 4 %}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="{{ sizeClass }}">
    {% if glyph == 0 %}
      <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3z"></path><path d="M3 12.5l9 4.5 9-4.5"></path>
    {% elif glyph == 1 %}
      <circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle>
    {% elif glyph == 2 %}
      <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path>
    {% else %}
      <rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
    {% endif %}
  </svg>
{% endmacro %}

{# =====================================================
   BENEFIT VISUAL MACRO — content-specific animated visual
   for each Feature Block, in place of a generic placeholder
   card. Each `type` (set per-benefit in platformProducts.js)
   maps to a small, self-contained, looping CSS/SVG animation
   that illustrates that specific benefit — a typed-answer chat
   bubble for "natural language", pulsing rings for "sub-100ms",
   a connecting node graph for "connect any data source", etc.
   Pure CSS/SVG loops (no JS) so they run for free and pause
   naturally off-screen with no extra cost.
   ===================================================== #}
{% macro benefitVisual(type) %}
  {% if type == "typing" %}
    <div class="w-full max-w-[220px] space-y-2.5">
      <div class="flex justify-end">
        <span class="rounded-lg rounded-tr-sm bg-navy-50 px-3 py-1.5 text-[11px] leading-snug text-navy-600">What's our refund policy?</span>
      </div>
      <div class="flex justify-start">
        <span class="relative inline-flex min-h-[26px] items-center rounded-lg rounded-tl-sm bg-[#76B900]/10 px-3 py-1.5 text-[11px] leading-snug text-navy-800">
          <span class="benefit-answer-dots absolute inline-flex items-center gap-0.5">
            <span class="h-1 w-1 rounded-full bg-navy-400"></span>
            <span class="h-1 w-1 rounded-full bg-navy-400"></span>
            <span class="h-1 w-1 rounded-full bg-navy-400"></span>
          </span>
          <span class="benefit-answer-text">Refunds process within 3–5 days.</span>
        </span>
      </div>
    </div>
  {% elif type == "pulse" %}
    <div class="relative flex h-[100px] w-[100px] items-center justify-center">
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border border-[#76B900]/40"></span>
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border border-[#76B900]/40" style="animation-delay: 0.6s"></span>
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border border-[#76B900]/40" style="animation-delay: 1.2s"></span>
      <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy-950 text-white shadow-md">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13 2L4.5 14h6l-1 8L19 10h-6l1-8z"></path>
        </svg>
      </span>
    </div>
  {% elif type == "connect" %}
    <div class="relative flex h-[120px] w-[160px] items-center justify-center">
      <svg viewBox="0 0 160 120" class="absolute inset-0 h-full w-full" fill="none" aria-hidden="true">
        <path class="benefit-connect-line" d="M80 60 L30 25" stroke="#76B900" stroke-width="1.5"></path>
        <path class="benefit-connect-line" d="M80 60 L130 25" stroke="#76B900" stroke-width="1.5" style="animation-delay: 0.3s"></path>
        <path class="benefit-connect-line" d="M80 60 L30 95" stroke="#76B900" stroke-width="1.5" style="animation-delay: 0.6s"></path>
        <path class="benefit-connect-line" d="M80 60 L130 95" stroke="#76B900" stroke-width="1.5" style="animation-delay: 0.9s"></path>
      </svg>
      <span class="benefit-node absolute left-[19px] top-[14px] h-3 w-3 rounded-full border-2 border-[#76B900] bg-white shadow" style="animation-delay: 0.4s"></span>
      <span class="benefit-node absolute right-[19px] top-[14px] h-3 w-3 rounded-full border-2 border-[#76B900] bg-white shadow" style="animation-delay: 0.7s"></span>
      <span class="benefit-node absolute bottom-[14px] left-[19px] h-3 w-3 rounded-full border-2 border-[#76B900] bg-white shadow" style="animation-delay: 1s"></span>
      <span class="benefit-node absolute bottom-[14px] right-[19px] h-3 w-3 rounded-full border-2 border-[#76B900] bg-white shadow" style="animation-delay: 1.3s"></span>
      <span class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full bg-navy-950 text-white shadow-md">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path>
        </svg>
      </span>
    </div>
  {% elif type == "gauge" %}
    <div class="flex items-center gap-4">
      <svg viewBox="0 0 80 80" class="h-20 w-20 -rotate-90" aria-hidden="true">
        <circle cx="40" cy="40" r="34" fill="none" stroke="#E5E9EB" stroke-width="8"></circle>
        <circle cx="40" cy="40" r="34" fill="none" stroke="#76B900" stroke-width="8" stroke-linecap="round" class="benefit-gauge-ring"></circle>
      </svg>
      <div>
        <span class="block font-mono text-[22px] font-semibold text-navy-950">92<span class="text-[13px]">%</span></span>
        <span class="block text-[11px] text-navy-500">buying intent</span>
      </div>
    </div>
  {% elif type == "list" %}
    <div class="w-full max-w-[220px] space-y-2">
      <div class="benefit-list-row flex items-center gap-2 rounded-md bg-navy-50/70 px-3 py-2">
        <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
        <span class="text-[11px] text-navy-600">Call logged — Acme Co.</span>
      </div>
      <div class="benefit-list-row flex items-center gap-2 rounded-md bg-navy-50/70 px-3 py-2" style="animation-delay: 0.5s">
        <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
        <span class="text-[11px] text-navy-600">Email captured</span>
      </div>
      <div class="benefit-list-row flex items-center gap-2 rounded-md bg-navy-50/70 px-3 py-2" style="animation-delay: 1s">
        <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
        <span class="text-[11px] text-navy-600">Meeting note synced</span>
      </div>
    </div>
  {% elif type == "path" %}
    <div class="relative w-full max-w-[220px] px-1">
      <div class="relative h-[3px] w-full rounded-full bg-navy-100">
        <span class="benefit-path-progress absolute left-0 top-0 h-full rounded-full bg-[#76B900]"></span>
      </div>
      <div class="-mt-[8px] flex items-center justify-between">
        <span class="benefit-path-dot h-4 w-4 rounded-full border-2 border-white shadow"></span>
        <span class="benefit-path-dot h-4 w-4 rounded-full border-2 border-white shadow" style="animation-delay: 1s"></span>
        <span class="benefit-path-dot h-4 w-4 rounded-full border-2 border-white shadow" style="animation-delay: 2s"></span>
      </div>
      <div class="mt-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-wide text-navy-500">
        <span>Contact</span><span>Follow up</span><span>Close</span>
      </div>
    </div>
  {% elif type == "stack" %}
    <div class="relative flex h-[110px] w-[140px] items-center justify-center">
      <span class="absolute h-16 w-32 translate-y-6 rounded-lg bg-navy-100/60"></span>
      <span class="benefit-stack-layer absolute h-16 w-32 translate-y-3 rounded-lg bg-navy-100/90" style="animation-delay: 0.3s"></span>
      <span class="benefit-stack-layer relative flex h-16 w-32 items-center justify-center rounded-lg border border-white/70 bg-white shadow-md">
        <span class="h-2 w-2 rounded-full bg-[#76B900]"></span>
      </span>
    </div>
  {% elif type == "sync" %}
    <div class="relative flex h-[100px] w-[150px] items-center justify-center gap-6">
      <span class="benefit-sync-node relative flex h-9 w-9 items-center justify-center rounded-full border border-navy-100 bg-white shadow">
        <span class="h-2 w-2 rounded-full bg-[#76B900]"></span>
      </span>
      <svg class="h-6 w-10 flex-shrink-0 text-navy-300" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 40 24" aria-hidden="true">
        <path d="M2 8h30M26 3l6 5-6 5"></path>
        <path d="M38 16H8M14 21l-6-5 6-5"></path>
      </svg>
      <span class="benefit-sync-node relative flex h-9 w-9 items-center justify-center rounded-full border border-navy-100 bg-white shadow" style="animation-delay: 1s">
        <span class="h-2 w-2 rounded-full bg-[#76B900]"></span>
      </span>
    </div>
  {% endif %}
{% endmacro %}

{# =====================================================
   HERO — centered single-column on a plain white ground,
   with floating capability badges top-left/top-right
   (Kore.ai reference, 2026-07-28) and a per-product
   interactive element: an animated typing search bar for
   Zunkiree Search only (the one product that's actually
   search), or a static quick-action pill row for AI CRM and
   Orca (no fabricated live-search feature on products that
   don't have one).
   ===================================================== #}
<section class="relative flex flex-col items-center justify-center overflow-hidden px-4 pb-8 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pt-44" aria-labelledby="hero-heading">

  {% if product.hero.badges and product.hero.badges.length %}
    <div class="pointer-events-none absolute inset-0 z-0 hidden md:block" aria-hidden="true">
      <!-- Ambient glow behind each tight badge cluster, anchored to the headline's horizontal center.
           top-[124px] clears the fixed navbar (72px tall, z-50) — the hero section starts at the
           very top of the document since the nav is `fixed`/out of flow, so anything above ~72px
           renders underneath it. -->
      <div class="absolute left-[calc(50%-400px)] top-[124px] h-56 w-56 -translate-x-1/2 rounded-full bg-gradient-to-br from-sky-200/50 via-sky-100/25 to-transparent blur-3xl"></div>
      <div class="absolute right-[calc(50%-400px)] top-[124px] h-56 w-56 translate-x-1/2 rounded-full bg-gradient-to-bl from-sky-200/50 via-sky-100/25 to-transparent blur-3xl"></div>

      {# Anchored to the hero's horizontal center via calc(), so the cluster
         hugs the headline's edge regardless of container width — not the
         hero section's outer edge. Vertically placed just above the eyebrow
         pill/headline band (hero has pt-32/36/44 before that content). #}
      {% for badge in product.hero.badges %}
        {% if badge.side == "left" and badge.offset == "outer" %}
          {% set posClass = "left-[calc(50%-390px)] top-[132px] -rotate-6" %}
        {% elif badge.side == "left" %}
          {% set posClass = "left-[calc(50%-350px)] top-[180px] rotate-6" %}
        {% elif badge.side == "right" and badge.offset == "inner" %}
          {% set posClass = "right-[calc(50%-350px)] top-[180px] -rotate-6" %}
        {% else %}
          {% set posClass = "right-[calc(50%-390px)] top-[132px] rotate-6" %}
        {% endif %}
        <div
          class="tile-float absolute flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-navy-950 text-white shadow-md {{ posClass }}"
          style="animation-delay: {{ loop.index0 * 0.6 }}s; box-shadow: 0 12px 20px -8px rgba(15, 23, 42, 0.5);"
        >
          <div
            class="pointer-events-none absolute inset-0"
            style="background: radial-gradient(ellipse 100% 100% at 20% 100%, rgba(118,185,0,0.45) 0%, transparent 70%);"
          ></div>
          <svg class="relative z-10 h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            {{ heroBadgeIcon(badge.icon) }}
          </svg>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    {% if product.hero.statusBadge %}
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1.5">
        <span class="h-2 w-2 flex-shrink-0 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-amber-700">{{ product.hero.statusBadge }}</span>
      </span>
    {% endif %}

    <span class="mb-4 inline-flex items-center rounded-full border border-sky-200/60 bg-gradient-to-br from-sky-50 to-white px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-500 shadow-subtle">
      {{ product.eyebrow }}
    </span>

    <h1 id="hero-heading" class="text-center text-balance text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
      {{ product.hero.headline }}
    </h1>

    {% if product.hero.subhead %}
      <p class="mt-4 max-w-[560px] px-4 text-center text-[18px] font-medium leading-relaxed tracking-tight text-[#6B7280] sm:max-w-none sm:text-[20px]">
        {{ product.hero.subhead | safe }}
      </p>
    {% endif %}

    {% if product.hero.interaction.type == "typingSearch" %}
      <div class="mt-8 w-full max-w-xl" data-reveal>
        <div class="flex items-center gap-3 rounded-full border border-sky-200/70 bg-gradient-to-br from-sky-50 via-white to-sky-50 px-5 py-3.5 shadow-md">
          <svg class="h-5 w-5 flex-shrink-0 text-sky-500" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
          </svg>
          <span class="flex-1 min-w-[160px] truncate text-left text-[15px] text-[#111827]">
            <span id="hero-typing-text"></span><span class="hero-typing-cursor inline-block h-[16px] w-[2px] translate-y-[2px] bg-sky-400" aria-hidden="true"></span>
          </span>
          <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-navy-900 text-white" aria-hidden="true">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </div>
        <ul id="hero-typing-queries" hidden>
          {% for query in product.hero.interaction.queries %}
            <li>{{ query }}</li>
          {% endfor %}
        </ul>

        {% if product.hero.interaction.suggestionPills and product.hero.interaction.suggestionPills.length %}
          <div class="mt-5 flex max-w-xl flex-wrap items-center justify-center gap-2" data-reveal-stagger>
            {% for item in product.hero.interaction.suggestionPills %}
              <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-navy-100/60 bg-white px-3 py-1.5 font-mono text-[11px] text-navy-600 shadow-subtle">
                <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z"></path></svg>
                {{ item.label }}
              </span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <style>
        @keyframes hero-typing-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
        .hero-typing-cursor { animation: hero-typing-blink 0.9s step-end infinite; }
      </style>
      <script>
        (function () {
          var textEl = document.getElementById('hero-typing-text');
          var listEl = document.getElementById('hero-typing-queries');
          if (!textEl || !listEl) return;
          var queries = Array.prototype.map.call(listEl.querySelectorAll('li'), function (li) { return li.textContent; });
          if (!queries.length) return;
          var qi = 0, ci = 0, deleting = false;
          function tick() {
            var current = queries[qi];
            if (!deleting) {
              ci++;
              textEl.textContent = current.slice(0, ci);
              if (ci >= current.length) { deleting = true; setTimeout(tick, 1500); return; }
            } else {
              ci--;
              textEl.textContent = current.slice(0, ci);
              if (ci <= 0) { deleting = false; qi = (qi + 1) % queries.length; setTimeout(tick, 300); return; }
            }
            setTimeout(tick, deleting ? 28 : 55);
          }
          tick();
        })();
      </script>
    {% elif product.hero.interaction.type == "pills" %}
      <div class="mt-8 flex max-w-2xl flex-wrap items-center justify-center gap-2.5" data-reveal-stagger>
        {% for item in product.hero.interaction.items %}
          <span class="inline-flex items-center gap-1.5 rounded-full border border-navy-100/60 bg-white px-3.5 py-2 font-mono text-[12px] text-navy-600 shadow-subtle">
            <svg class="h-3.5 w-3.5 text-[#76B900]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z"></path></svg>
            {{ item.label }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mt-8 flex items-center justify-center">
      <a
        href="{{ product.hero.ctaPrimary.href }}"
        class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
      >
        {{ product.hero.ctaPrimary.label }}
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

{# =====================================================
   CHALLENGE STRIP — short framing strip, 3 compact blocks.
   Reuses industry.njk's Pain Point section pattern verbatim
   (asymmetric lead + 2 secondary blocks, animated visuals)
   instead of the flat 3-up icon grid.
   ===================================================== #}
{% if product.challenges %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="challenges-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="challenges-heading" class="mb-8 text-center text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[28px]">
      {{ product.challenges.heading }}
    </h2>
    <div class="overflow-hidden rounded-xl border border-navy-100/60 bg-gradient-to-br from-sky-50/60 via-white to-white shadow-card transition-shadow duration-300 hover:shadow-card-hover" data-reveal-stagger>
      <div class="flex flex-col divide-y divide-navy-200 sm:flex-row sm:divide-y-0">
        {% for block in product.challenges.blocks %}
          {% if loop.index == 1 %}
            <div class="flex min-h-[360px] flex-col justify-center p-8 sm:w-3/5 sm:border-r sm:border-navy-200 lg:p-12">
              <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-sky-600">Primary</p>
              <p class="text-[26px] font-semibold leading-snug text-[#111827] sm:text-[28px]">{{ block.title }}</p>
              <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
              {{ painPointVisual(1) }}
            </div>
          {% endif %}
        {% endfor %}
        <div class="flex flex-col sm:w-2/5">
          {% for block in product.challenges.blocks %}
            {% if loop.index != 1 %}
              <div class="flex min-h-[180px] flex-1 flex-col justify-center p-7 lg:p-9{% if loop.index == 2 %} border-b border-navy-200{% endif %}">
                <p class="text-[19px] font-semibold leading-snug text-[#111827]">{{ block.title }}</p>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
                {{ painPointVisual(loop.index) }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .pp-visual {
    margin-top: 20px;
    width: fit-content;
    align-self: flex-start;
  }

  /* Lead visual: a stalled chat bubble — typing dots that never
     resolve into a reply, plus a slow "waiting" ring around it. */
  .pp-visual--lead {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .pp-chat-bubble {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 999px 999px 999px 4px;
    background: #eff7ff;
    border: 1px solid #bfe1fc;
  }
  .pp-chat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2673b8;
    animation: pp-chat-dot-bounce 1.2s ease-in-out infinite;
  }
  .pp-chat-dot:nth-child(2) { animation-delay: 0.15s; }
  .pp-chat-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pp-chat-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
  .pp-chat-ring {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 999px;
    border: 1px solid #93ccfa;
    opacity: 0;
    animation: pp-chat-ring-pulse 2.4s ease-out infinite;
  }
  @keyframes pp-chat-ring-pulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.25); opacity: 0; }
  }

  /* Secondary visual 1: two nodes with a dashed line whose gap
     pulses — reads as "connected but not really talking." */
  .pp-visual--sm {
    display: flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }
  .pp-node {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #dbeffe;
    border: 1.5px solid #2673b8;
  }
  .pp-node-line {
    width: 44px;
    height: 8px;
    overflow: visible;
  }
  .pp-node-line line {
    stroke: #93ccfa;
    animation: pp-node-line-pulse 2s ease-in-out infinite;
  }
  @keyframes pp-node-line-pulse {
    0%, 100% { stroke-dashoffset: 0; opacity: 0.5; }
    50% { stroke-dashoffset: 8; opacity: 1; }
  }

  /* Secondary visual 2: stacked rows cycling in place — reads as
     repetitive manual sorting/triage. */
  .pp-visual--rows {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
  .pp-row {
    display: block;
    height: 5px;
    width: 46px;
    border-radius: 2px;
    background: #bfe1fc;
    animation: pp-row-cycle 1.8s ease-in-out infinite;
  }
  @keyframes pp-row-cycle {
    0%, 100% { transform: translateX(0); opacity: 0.6; }
    50% { transform: translateX(5px); opacity: 1; background: #60aef5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-chat-dot,
    .pp-chat-ring,
    .pp-node-line line,
    .pp-row {
      animation: none;
    }
  }
</style>
{% endif %}

{# =====================================================
   FEATURE BLOCKS — alternating 50/50 text+visual sections,
   fed by the product's benefits array (Kore.ai's "Turning
   interactions into outcomes" rhythm, restyled with our own
   glass-card tile motif rather than their visuals).
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="benefits-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="benefits-heading" class="sr-only">Benefits</h2>
    <div class="flex flex-col gap-12 sm:gap-16">
      {% for benefit in product.benefits %}
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12" data-reveal-stagger>
          <div class="{{ 'lg:order-2' if loop.index0 % 2 == 1 else '' }}">
            <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-navy-500">{{ '0' + (loop.index) | string }}</span>
            <h3 class="text-[24px] font-semibold leading-[1.2] text-[#111827] sm:text-[28px]">
              {{ benefit.title }}
            </h3>
            <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-[#6B7280]">
              {{ benefit.description }}
            </p>
          </div>

          <div class="{{ 'lg:order-1' if loop.index0 % 2 == 1 else '' }} relative flex min-h-[220px] items-center justify-center rounded-xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 backdrop-blur-md" aria-hidden="true">
            <div class="tile-float flex w-full max-w-[260px] flex-col items-center rounded-xl border border-white/70 bg-white p-5 shadow-md">
              <div class="mb-4 flex w-full items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-[#76B900]"></span>
                <span class="font-mono text-[10px] uppercase tracking-wider text-navy-500">{{ product.eyebrow }}</span>
              </div>
              <div class="flex flex-1 items-center justify-center">
                {{ benefitVisual(benefit.visual) }}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  @keyframes tile-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .tile-float {
    animation: tile-float 4s ease-in-out infinite;
  }

  /* Benefit visuals — content-specific looping animations, see benefitVisual() macro. */
  @keyframes benefit-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
  @keyframes benefit-swap-dots {
    0%, 35% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes benefit-swap-text {
    0%, 35% { opacity: 0; }
    45%, 100% { opacity: 1; }
  }
  .benefit-answer-dots {
    animation: benefit-swap-dots 4s ease-in-out infinite;
  }
  .benefit-answer-dots span {
    animation: benefit-dot-bounce 1s ease-in-out infinite;
  }
  .benefit-answer-dots span:nth-child(2) { animation-delay: 0.15s; }
  .benefit-answer-dots span:nth-child(3) { animation-delay: 0.3s; }
  .benefit-answer-text {
    opacity: 0;
    animation: benefit-swap-text 4s ease-in-out infinite;
  }

  @keyframes benefit-pulse-ring {
    0% { transform: scale(0.6); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .benefit-pulse-ring {
    animation: benefit-pulse-ring 1.8s ease-out infinite;
  }

  @keyframes benefit-line-draw {
    0% { stroke-dashoffset: 60; opacity: 0.3; }
    35% { stroke-dashoffset: 0; opacity: 1; }
    80% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 60; opacity: 0.3; }
  }
  .benefit-connect-line {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: benefit-line-draw 2.4s ease-in-out infinite;
  }
  @keyframes benefit-node-in {
    0% { opacity: 0; transform: scale(0.5); }
    20% { opacity: 1; transform: scale(1); }
    80% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.5); }
  }
  .benefit-node {
    opacity: 0;
    transform: scale(0.5);
    animation: benefit-node-in 2.4s ease-in-out infinite;
  }

  @keyframes benefit-gauge-fill {
    0% { stroke-dashoffset: 213.6; }
    60% { stroke-dashoffset: 17.1; }
    100% { stroke-dashoffset: 17.1; }
  }
  .benefit-gauge-ring {
    stroke-dasharray: 213.6;
    stroke-dashoffset: 213.6;
    animation: benefit-gauge-fill 2.6s ease-out infinite;
  }

  @keyframes benefit-list-in {
    0% { opacity: 0; transform: translateX(-10px); }
    15% { opacity: 1; transform: translateX(0); }
    85% { opacity: 1; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(-10px); }
  }
  .benefit-list-row {
    opacity: 0;
    transform: translateX(-10px);
    animation: benefit-list-in 3s ease-in-out infinite;
  }

  @keyframes benefit-path-fill {
    0% { width: 0%; }
    100% { width: 100%; }
  }
  .benefit-path-progress {
    width: 0%;
    animation: benefit-path-fill 3s ease-in-out infinite;
  }
  @keyframes benefit-path-light {
    0%, 32% { background-color: #D9DEE2; }
    40%, 100% { background-color: #76B900; }
  }
  .benefit-path-dot {
    background-color: #D9DEE2;
    animation: benefit-path-light 3s ease-in-out infinite;
  }

  .benefit-stack-layer {
    animation: tile-float 4s ease-in-out infinite;
  }

  @keyframes benefit-node-ping {
    0%, 100% { box-shadow: 0 0 0 0 rgba(118, 185, 0, 0); }
    50% { box-shadow: 0 0 0 6px rgba(118, 185, 0, 0.15); }
  }
  .benefit-sync-node {
    animation: benefit-node-ping 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-answer-dots,
    .benefit-answer-dots span,
    .benefit-answer-text,
    .benefit-pulse-ring,
    .benefit-connect-line,
    .benefit-node,
    .benefit-gauge-ring,
    .benefit-list-row,
    .benefit-path-progress,
    .benefit-path-dot,
    .benefit-stack-layer,
    .benefit-sync-node,
    .tile-float {
      animation: none !important;
    }
  }
</style>

{# =====================================================
   USE CASES — segmented tab bar over a split content/visual
   card (Kore.ai's "Built for how your users actually search"
   tabbed pattern), restyled with our navy/mono/#76B900 accent
   system. Panel content is generic off product.useCases.items
   (title/description/features) so it works unmodified for
   search, ai-crm, and orca — no per-product markup forks.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="usecases-heading" x-data="{ active: 0 }">
  <div class="mx-auto max-w-5xl">
    <h2 id="usecases-heading" class="mb-8 text-center text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[30px]">
      {{ product.useCases.heading }}
    </h2>

    {% if product.useCases.items and product.useCases.items.length > 1 %}
      <div role="tablist" aria-label="{{ product.useCases.heading }}" class="mb-6 flex flex-wrap items-center justify-center gap-2" data-reveal>
        {% for item in product.useCases.items %}
          <button
            type="button"
            role="tab"
            id="usecase-tab-{{ loop.index0 }}"
            aria-controls="usecase-panel-{{ loop.index0 }}"
            :aria-selected="active === {{ loop.index0 }} ? 'true' : 'false'"
            :tabindex="active === {{ loop.index0 }} ? 0 : -1"
            @click="active = {{ loop.index0 }}"
            @keydown.right.prevent="active = (active + 1) % {{ product.useCases.items.length }}; $nextTick(() => $refs['usecaseTab' + active].focus())"
            @keydown.left.prevent="active = (active - 1 + {{ product.useCases.items.length }}) % {{ product.useCases.items.length }}; $nextTick(() => $refs['usecaseTab' + active].focus())"
            x-ref="usecaseTab{{ loop.index0 }}"
            class="rounded-full px-4 py-2 font-mono text-[12px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            :class="active === {{ loop.index0 }} ? 'bg-navy-900 text-white' : 'bg-navy-50/70 text-navy-500 hover:bg-navy-100'"
          >
            {{ item.title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {% for item in product.useCases.items %}
      <div
        id="usecase-panel-{{ loop.index0 }}"
        role="tabpanel"
        aria-labelledby="usecase-tab-{{ loop.index0 }}"
        x-show="active === {{ loop.index0 }}"
        {% if not loop.first %}x-cloak{% endif %}
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        class="grid grid-cols-1 overflow-hidden rounded-2xl border border-navy-100/60 bg-white shadow-subtle lg:grid-cols-2"
        data-reveal
      >
        <div class="flex flex-col justify-center p-8 sm:p-10">
          <p class="text-[20px] font-semibold leading-snug text-[#111827] sm:text-[22px]">{{ item.title }}</p>
          <p class="mt-2 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">{{ item.description }}</p>

          {% if item.features and item.features.length %}
            <ul class="mt-6 border-t border-navy-100/70">
              {% for feature in item.features %}
                <li class="flex items-center gap-3 border-b border-navy-100/70 py-3.5">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-[#F0F5E8] text-[#5a9100]" aria-hidden="true">
                    {{ useCaseIcon(loop.index0) }}
                  </span>
                  <span class="text-[14px] font-medium text-[#111827]">{{ feature }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <a
            href="{{ product.hero.ctaPrimary.href }}"
            class="mt-7 inline-flex w-fit items-center gap-2 rounded-md border border-navy-200 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-navy-700 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          >
            {{ product.hero.ctaPrimary.label }}
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
          </a>
        </div>

        <div class="relative flex items-center justify-center bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-8 sm:p-10" aria-hidden="true">
          <div class="flex w-full max-w-[260px] flex-col items-center gap-5 rounded-xl border border-white/70 bg-white p-6 shadow-md">
            <span class="flex items-center gap-2 self-start rounded-full bg-navy-50 px-3 py-1.5">
              <span class="usecase-engine-ping h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]"></span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-navy-500">{{ item.title }}</span>
            </span>

            <div class="relative flex h-[68px] w-full items-center justify-center">
              <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40"></span>
              <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40" style="animation-delay: 0.6s"></span>
              <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40" style="animation-delay: 1.2s"></span>
              <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy-950 text-white shadow-md">
                {{ useCaseIcon(loop.index0, "h-5 w-5") }}
              </span>
            </div>

            {% if item.features and item.features.length %}
              <div class="w-full space-y-2">
                {% for feature in item.features %}
                  <div class="benefit-list-row flex items-center gap-2 rounded-md bg-navy-50/70 px-3 py-2" style="animation-delay: {{ loop.index0 * 0.5 }}s">
                    <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                    <span class="truncate text-[11px] text-navy-600">{{ feature }}</span>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  @keyframes usecase-engine-ping {
    0%, 100% { box-shadow: 0 0 0 0 rgba(118, 185, 0, 0.4); }
    50% { box-shadow: 0 0 0 4px rgba(118, 185, 0, 0); }
  }
  .usecase-engine-ping {
    animation: usecase-engine-ping 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .usecase-engine-ping {
      animation: none !important;
    }
  }
</style>

{# =====================================================
   PLATFORM TIE-IN — dark navy card, cross-linking the other
   two platform pillars by name. Reuses industry.njk's Platform
   Tie-In card pattern.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="platform-tie-in-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-2xl bg-navy-950 p-8 sm:p-10 lg:p-12"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.25) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.3) 0%, transparent 60%);"
      ></div>
      {# Same background-pattern treatment as the "AI & Machine Learning" capability card on
         about.njk — a different asset (card-info-01, not card-info-02) so this card doesn't
         repeat that card's exact texture. Applied to the whole card, not just the pillars. #}
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-cover bg-center opacity-[0.1]"
        style="background-image: url('/assets/images/card-info-01.avif');"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">Platform</span>
        <h2 id="platform-tie-in-heading" class="max-w-xl text-[24px] font-medium leading-[1.2] text-white sm:text-[28px]">
          {{ product.platformTieIn.heading }}
        </h2>
        <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-white/60">
          {{ product.platformTieIn.body }}
        </p>

        {% if product.platformTieIn.pillars and product.platformTieIn.pillars.length %}
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {% for pillar in product.platformTieIn.pillars %}
              <a href="{{ pillar.href }}" class="group rounded-xl border border-white/15 bg-white/5 p-4 transition-colors duration-200 hover:border-white/30 hover:bg-white/10">
                <span class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-wide text-white">
                  {{ pillar.name }}
                  <span class="h-1 w-1 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
                </span>
                <span class="mt-1.5 block text-[13px] leading-relaxed text-white/60">{{ pillar.description }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        <a
          href="{{ product.platformTieIn.cta.href }}"
          class="mt-7 inline-flex items-center gap-2 rounded-md border border-white/20 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.platformTieIn.cta.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   PROOF / TESTIMONIAL — single quote card, reused from
   homepage-v2's Proof/Testimonials pattern. Renders only when
   a real client quote exists for this product.
   ===================================================== #}
{% if product.testimonial %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="testimonial-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="testimonial-heading" class="sr-only">What our clients say</h2>
    <div class="relative flex min-h-[220px] flex-col justify-between overflow-hidden rounded-2xl border border-navy-100/50 bg-white p-8 shadow-md sm:p-10" data-reveal>
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 80% 20%, rgba(118, 185, 0, 0.05) 0%, transparent 60%);"></div>
      <blockquote class="relative z-10 max-w-lg text-[22px] font-medium leading-snug text-[#111827] sm:text-[26px]">
        "{{ product.testimonial.quote }}"
      </blockquote>
      <footer class="relative z-10 mt-8 flex items-center gap-3">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 font-mono text-[12px] font-semibold uppercase text-[#6B7280]">
          {{ product.testimonial.company[0] }}
        </span>
        <cite class="text-[13px] font-normal not-italic leading-tight text-[#6B7280]">{{ product.testimonial.role }}</cite>
      </footer>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   FAQ — accordion, reused from homepage-v2's FAQ pattern.
   Renders only when the product has real FAQ content.
   ===================================================== #}
{% if product.faq and product.faq.length %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Support
      </span>
      <h2 id="faq-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Frequently asked questions
      </h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for item in product.faq %}
          <div class="py-5">
            <button
              @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
              class="flex w-full items-center justify-between gap-4 text-left group"
              :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
              aria-controls="faq-answer-{{ loop.index }}"
            >
              <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
                {{ item.question }}
              </span>
              <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </button>
            <div
              id="faq-answer-{{ loop.index }}"
              x-show="activeIndex === {{ loop.index }}"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-2"
              class="overflow-hidden"
            >
              <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">{{ item.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   CLOSING DUAL CTA — same shell/copy pattern as homepage-v2's
   and industry.njk's closing CTA banner.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="closing-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <span class="relative z-10 mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">
        {{ product.closingCta.eyebrow }}
      </span>
      <h2 id="closing-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        {{ product.closingCta.headline }}
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        {{ product.closingCta.body }}
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="{{ product.closingCta.ctaPrimary.href }}"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.closingCta.ctaPrimary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
        <a
          href="{{ product.closingCta.ctaSecondary.href }}"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.closingCta.ctaSecondary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
