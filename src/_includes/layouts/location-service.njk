---
layout: base.njk
hideChrome: true
bodyClass: "v2-inter"
---

{# =====================================================
   LOCATION × SERVICE PAGE LAYOUT — WEBSITE V2
   Programmatic SEO pages for local service queries.

   Visual language matches homepage-v2.njk / product-v2.njk
   (same tokens, same component recipes): navbar-v2 + footer-v2
   chrome, centered hero with eyebrow pill + dual mono CTAs,
   white-card sections with the v2 icon-square treatment,
   navy closing CTA banner, GSAP data-reveal motion.

   Content, links, schema, and data schema are unchanged —
   this is a UI-only reskin of the existing template.
   ===================================================== #}

{% set location = null %}
{% for loc in locations %}
  {% if loc.id == locationId %}
    {% set location = loc %}
  {% endif %}
{% endfor %}

{% set service = null %}
{% for svc in services %}
  {% if svc.id == serviceId %}
    {% set service = svc %}
  {% endif %}
{% endfor %}

{% set serviceContent = location.services[serviceId] if location.services else null %}

{# =====================================================
   SERVICE SCHEMA
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "{{ site.url }}/locations/{{ location.id }}/{{ service.id }}/#service",
  "name": "{{ serviceContent.title | default(service.title + ' in ' + location.name) }}",
  "description": "{{ serviceContent.description | default(service.description) }}",
  "url": "{{ site.url }}/locations/{{ location.id }}/{{ service.id }}/",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/locations/{{ location.id }}/#localbusiness",
    "name": "Zunkiree Labs - {{ location.name }}"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ location.name }}",
    "containedInPlace": {
      "@type": "Country",
      "name": "{{ location.country }}"
    }
  },
  "serviceType": "{{ service.category }}"
}
</script>

<script>
  // Add synchronous class to html element to prevent FOUC (flash of unstyled content) before GSAP runs
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  /* Premium reveal fade-ins: hide items initially if JS is active so GSAP can animate them cleanly */
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{% include "partials/navbar-v2.njk" %}

{# =====================================================
   HERO — centered single-column, product-v2/homepage-v2 pattern.
   The navbar is `fixed` (72px tall, z-50), so pt-32/36/44 clears
   it before the breadcrumb, matching product-v2.njk's hero.
   ===================================================== #}
<section
  class="relative flex flex-col items-center justify-center overflow-hidden px-4 pb-12 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pt-44"
  aria-labelledby="hero-heading"
>
  <div
    class="relative z-10 mx-auto flex w-full max-w-[56rem] flex-col items-center text-center"
    data-reveal-stagger
  >
    {# Breadcrumb — restyled as the v2 mono track, same links/order as before #}
    <nav class="mb-8 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]" aria-label="Breadcrumb">
      <a href="/" class="transition-colors duration-200 hover:text-[#4d7a00]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/locations/" class="transition-colors duration-200 hover:text-[#4d7a00]">Locations</a>
      <span aria-hidden="true">/</span>
      <a href="/locations/{{ location.id }}/" class="transition-colors duration-200 hover:text-[#4d7a00]">{{ location.name }}</a>
      <span aria-hidden="true">/</span>
      <span class="font-medium text-navy-900">{{ service.title }}</span>
    </nav>

    {# Eyebrow — v2 pill treatment #}
    <span class="mb-4 inline-flex items-center rounded-full border border-sky-200/60 bg-gradient-to-br from-sky-50 to-white px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-500 shadow-subtle">
      {{ service.category }} in {{ location.name }}
    </span>

    <h1
      id="hero-heading"
      class="text-center text-balance text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]"
    >
      {{ serviceContent.title | default(service.title + ' in ' + location.name) }}
    </h1>

    <p class="mt-4 max-w-[560px] px-4 text-center text-[18px] font-medium leading-relaxed tracking-tight text-[#6B7280] sm:max-w-none sm:text-[20px]">
      {{ serviceContent.intro | default(service.description) }}
    </p>

    {# Dual CTAs — brand-green primary + outline secondary (same recipe as homepage-v2 hero) #}
    <div class="mt-8 flex w-full max-w-[320px] flex-col items-stretch justify-center gap-2 sm:max-w-none sm:flex-row sm:items-center sm:gap-3">
      <a
        href="/contact/"
        class="inline-flex min-w-0 flex-1 items-center justify-center gap-1.5 rounded-md bg-[#76B900] px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:flex-none"
      >
        Get Started
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
      </a>
      <a
        href="/services/{{ service.id }}/"
        class="inline-flex min-w-0 flex-1 items-center justify-center gap-1.5 rounded-md border border-navy-300 px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:flex-none"
      >
        Learn More About {{ service.title }}
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

{# =====================================================
   HIGHLIGHTS — "Why Choose Us" checklist in white cards,
   v2 icon-square treatment (product-v2 use-case feature rows).
   ===================================================== #}
{% if serviceContent.highlights %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="highlights-heading">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 max-w-2xl md:mb-12" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Why {{ location.name }}
      </span>
      <h2 id="highlights-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Why Choose Us for {{ service.title }} in {{ location.name }}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-reveal-stagger>
      {% for highlight in serviceContent.highlights %}
      <div class="flex items-start gap-4 rounded-2xl border border-navy-100/60 bg-white p-6 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-md">
        <span class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-[#F0F5E8] text-[#5a9100]" aria-hidden="true">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </span>
        <p class="text-[15px] leading-relaxed text-[#374151]">{{ highlight }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   RELATED SERVICES IN THIS LOCATION
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="related-services-heading">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 md:mb-12" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        More services
      </span>
      <h2 id="related-services-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Other Services in {{ location.name }}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {% for svc in services %}
      {% if svc.id != service.id %}
      <a
        href="/locations/{{ location.id }}/{{ svc.id }}/"
        class="group flex items-center justify-between gap-3 rounded-2xl border border-navy-100/60 bg-white p-5 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
      >
        <span class="min-w-0 text-[15px] font-medium leading-snug text-[#111827] transition-colors duration-200 group-hover:text-[#4d7a00]">
          {{ svc.title }}
        </span>
        <span class="mt-0.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-navy-200 transition-colors duration-200 group-hover:bg-[#76B900]" aria-hidden="true"></span>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   OTHER LOCATIONS
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="other-locations-heading">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 md:mb-10" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Other locations
      </span>
      <h2 id="other-locations-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        {{ service.title }} in Other Locations
      </h2>
    </div>

    <div class="flex flex-wrap gap-2.5" data-reveal-stagger>
      {% for loc in locations %}
      {% if loc.id != location.id %}
      <a
        href="/locations/{{ loc.id }}/{{ service.id }}/"
        class="inline-flex items-center gap-2 rounded-full border border-navy-100/60 bg-white px-4 py-2 font-mono text-[12px] text-navy-600 shadow-subtle transition-colors duration-200 hover:border-[#76B900]/40 hover:text-navy-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
      >
        {{ loc.name }}
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   CLOSING CTA — navy-950 rounded banner, same shell and
   green/navy gradient bloom as homepage-v2/product-v2.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="closing-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <h2 id="closing-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        Ready for {{ service.title }} in {{ location.name }}?
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        Let's discuss your project requirements.
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          Contact Us
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
